# ── LLM Provider ─────────────────────────────────────────────
LLM_PROVIDER=anthropic
LLM_API_KEY=sk-ant-...
LLM_MODEL=claude-sonnet-4-20250514
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=4096

# ── Storage ───────────────────────────────────────────────────
POSTGRES_URL=postgresql://daf:daf@localhost:5432/daf
REDIS_URL=redis://localhost:6379/0

# ── Policy ────────────────────────────────────────────────────
POLICY_STORE_PATH=./policy

# ── Observability ─────────────────────────────────────────────
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# ── R&D / Experiment Controls ────────────────────────────────
MAX_EXPERIMENT_COST_USD=0.50
COST_ALERT_THRESHOLD_USD=5.00
